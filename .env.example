PORT=3000

# Host local. O serviço api do Compose sobrescreve estes hosts.
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering

SQS_ENDPOINT=http://localhost:4566
SQS_REGION=us-east-1
SQS_QUEUE_NAME=wager-transactions.fifo

# iss do token (KC_HOSTNAME=localhost). As chaves podem ser buscadas por outra URL.
KEYCLOAK_ISSUER=http://localhost:8080/realms/jungle
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/jungle/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=wagering-api
KEYCLOAK_HEALTH_URL=http://localhost:8080/realms/jungle/.well-known/openid-configuration
