{
  "name": "jungle-gaming-wagering",
  "version": "0.1.0",
  "private": true,
  "description": "Processador distribuído de apostas — Jungle Gaming",
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "stack:up": "docker compose up -d postgres localstack keycloak",
    "stack:app": "docker compose --profile app up -d --build",
    "stack:down": "docker compose down",
    "db:migrate": "bun src/infra/database/migrate.ts up",
    "db:migrate:down": "bun src/infra/database/migrate.ts down",
    "db:migrate:status": "bun src/infra/database/migrate.ts status",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:e2e": "bun test test/e2e --timeout 60000",
    "test:cluster": "bun test test/cluster --timeout 180000",
    "test:all": "bun test test --timeout 180000",
    "test:load": "bun test/load/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.940.0",
    "@mikro-orm/core": "6.6.18",
    "@mikro-orm/migrations": "6.6.18",
    "@mikro-orm/postgresql": "6.6.18",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  }
}
